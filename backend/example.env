# ==============================================================================
# ENVIRONMENT CONFIGURATION
# ==============================================================================
# Development: Set local values matching your machine setup.
# Production:  Set secure values provided by our hosting provider or server.
# ==============================================================================

# Server port number (e.g., 3000, 8080)
PORT=

# Application runtime environment (development, production, test)
NODE_ENV=

# Full connection string for your database
# This project uses Drizzle ORM get your DB here: https://orm.drizzle.team/
DB_URL=

# Allowed frontend origin URL for CORS requests (e.g., http://localhost:5173 or any other DNS)
FR_ORIGIN=

# Minimum required character length for user passwords
PASSWORD_LENGTH=

# Object storage environment variables, for development purposes get these credentials at https://cloudinary.com/
CLOUDINARY_URL=

# Better Auth (authentication — email/password + Google)
# Secret signs/encrypts session cookies. Generate with: openssl rand -base64 32
# BETTER_AUTH_URL = backend origin (no path), e.g. http://localhost:3000
# (it may also be the full auth URL .../GDGoC-CTU-Main/v0.0.1/api/auth — nothing else)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=

# Google OAuth (optional — "Sign in with Google" stays disabled until both are set)
# Google Cloud Console → Authorized redirect URI:
#   <BETTER_AUTH_URL>/GDGoC-CTU-Main/v0.0.1/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional bootstrap admins: comma-separated Better Auth user IDs that are
# treated as admins even while their role is still the default "user".
# Sign up once, grab your user.id from the "user" table, set it here, restart.
ADMIN_USER_IDS=

