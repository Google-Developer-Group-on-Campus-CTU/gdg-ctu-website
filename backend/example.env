# ==============================================================================
# ENVIRONMENT CONFIGURATION
# ==============================================================================
# Development: Set local values matching your machine setup.
# Production:  Set secure values provided by our hosting provider or server.
# ==============================================================================

# Server port number (e.g., 3000, 8080)
PORT=

# Application runtime environment (development, production, test)
NODE_ENV=

# Full connection string for your database
# This project uses Drizzle ORM get your DB here: https://orm.drizzle.team/
DB_URL=

# Allowed frontend origin URL for CORS requests (e.g., http://localhost:3000 or any other DNS)
FR_ORIGIN=

# Minimum required character length for user passwords
PASSWORD_LENGTH=

# Object storage environment variables, for development purposes get these credentials at https://cloudinary.com/
CLOUDINARY_URL=

# Clerk auth environment variables (Used for authentication and organization access)
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Redis Cache
REDIS_URL=

# DEV-ONLY instant-admin bypass (NEVER set in production; ignored when NODE_ENV=production).
# Default: unset (bypass off = normal Clerk auth). Set to `true` to let requests
# send header `x-dev-admin-bypass: dev-instant-admin` and act as the fake admin
# `dev-instant-admin` without signing in via Clerk. Every use is logger.warn'ed.
DEV_ADMIN_BYPASS=
