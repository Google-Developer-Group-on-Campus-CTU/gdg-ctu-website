# Copy this file to `.env` and fill in the values.
# Backend API base URL, INCLUDING the base path:
# e.g. VITE_API_URL=https://<backend-host>/GDGoC-CTU-Main/v0.0.1
# Auth (Better Auth) runs behind this same base — no other keys needed here.
# Local development:
VITE_API_URL=http://localhost:3000/GDGoC-CTU-Main/v0.0.1
